{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service_topology",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "fixture": {"const": "hand-written"},
    "note": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "internet_facing", "sensitivity"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"},
          "label": {"type": "string", "minLength": 1},
          "internet_facing": {"type": "boolean"},
          "sensitivity": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "privilege", "sensitivity"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "privilege": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "sensitivity": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    }
  }
}
