{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/witold-andelie/PulseGuard/contracts/patchset.schema.json",
  "title": "PatchSet",
  "description": "Search/replace patch set (adapted from revio PatchSet). Doubles as the Remediator's structured-output schema. Max 3 attempts per case. S2 adds state rolled_back.",
  "type": "object",
  "required": ["ops", "rationale", "attempt"],
  "properties": {
    "case_id": { "type": "string" },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "old", "new"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "old": { "type": "string", "minLength": 1 },
          "new": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "state": {
      "type": "string",
      "enum": ["proposed", "sandbox_failed", "sandbox_passed", "approved", "applied", "rolled_back"]
    }
  },
  "additionalProperties": false
}
